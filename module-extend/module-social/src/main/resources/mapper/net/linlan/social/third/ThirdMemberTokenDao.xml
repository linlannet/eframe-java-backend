<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.social.third.dao.ThirdMemberTokenDao">

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.social.third.entity.ThirdMemberToken" id="thirdMemberTokenMap">
        <id property="id" column="MEMBER_ID"/>
        <result property="userId" column="USER_ID"/>
        <result property="token" column="TOKEN"/>
        <result property="foreignId" column="FOREIGN_ID"/>
        <result property="username" column="USERNAME"/>
        <result property="loginIp" column="LOGIN_IP"/>
        <result property="updateTime" column="UPDATE_TIME"/>
        <result property="expireTime" column="EXPIRE_TIME"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="description" column="DESCRIPTION"/>
    </resultMap>

    <!-- find by id，通过主键获取对象 -->
    <select id="findById" resultMap="thirdMemberTokenMap">
        SELECT
MEMBER_ID, USER_ID, TOKEN, FOREIGN_ID, USERNAME, LOGIN_IP, UPDATE_TIME, EXPIRE_TIME, CREATE_TIME, DESCRIPTION
        FROM THIRD_MEMBER_TOKEN B
        WHERE B.MEMBER_ID = #{value}
    </select>

    <!-- get list，通过输入的条件，获取返回的list列表对象，采用相应的分页规则进行分页处理 -->
    <select id="getList" resultMap="thirdMemberTokenMap">
        SELECT
B.MEMBER_ID, B.USER_ID, B.TOKEN, B.FOREIGN_ID, B.USERNAME, B.LOGIN_IP, B.UPDATE_TIME, B.EXPIRE_TIME, B.CREATE_TIME, B.DESCRIPTION
        FROM THIRD_MEMBER_TOKEN B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>
    </select>

    <!-- 通用排序SQL，如果传入参数按照参数排序，如果未传入参数，按照主键排序 -->
    <sql id="getListOrderBy">
        <choose>
            <when test='orderBy != null'>
                <choose>
                    <when test='orderBy == 0'>
                        ORDER BY B.CREATE_TIME DESC
                    </when>
                    <when test='orderBy == 1'>
                        ORDER BY B.CREATE_TIME ASC
                    </when>
                    <when test='orderBy == 2'>
                        ORDER BY B.PRIORITY DESC
                    </when>
                    <when test='orderBy == 3'>
                        ORDER BY B.PRIORITY ASC
                    </when>
                    <otherwise>
                        ORDER BY B.MEMBER_ID ASC
                    </otherwise>
                </choose>
            </when>
            <otherwise>
                ORDER BY B.MEMBER_ID DESC
            </otherwise>
        </choose>
    </sql>

    <!-- sql commonList 通过输入的条件，获取返回的list列表对象 -->
    <sql id="commonList">
        <!--  只允许默认的本表的字段查询，查询条件可通过Param定义，默认全部字段，后续根据Param内的定义，可删除不需要的查询字段 -->
        <if test="id != null and id != ''">
            and B.MEMBER_ID = #{id}
        </if>
        <if test="token != null and token != ''">
            and B.TOKEN = #{token}
        </if>
        <if test="foreignId != null and foreignId != ''">
            and B.FOREIGN_ID = #{foreignId}
        </if>
        <if test="username != null and username != ''">
            and B.USERNAME = #{username}
        </if>
        <if test="loginIp != null and loginIp != ''">
            and B.LOGIN_IP = #{loginIp}
        </if>
        <if test="updateTime != null and updateTime != ''">
            and B.UPDATE_TIME = #{updateTime}
        </if>
        <if test="expireTime != null and expireTime != ''">
            and B.EXPIRE_TIME = #{expireTime}
        </if>
        <if test="description != null and description != ''">
            and B.DESCRIPTION = #{description}
        </if>

        <!-- 各个数据库差异化的查询条件处理，如时间字段 -->
        <choose>
            <when test='_databaseId == "mysql"'>

            </when>
            <when test='_databaseId == "dm8"'>

            </when>
            <otherwise>

            </otherwise>
        </choose>

    </sql>

    <!-- save object，保存对象信息 -->
    <insert id="save" parameterType="net.linlan.social.third.entity.ThirdMemberToken">
        INSERT INTO THIRD_MEMBER_TOKEN
        (
MEMBER_ID, USER_ID, TOKEN, FOREIGN_ID, USERNAME, LOGIN_IP, UPDATE_TIME, EXPIRE_TIME, CREATE_TIME, DESCRIPTION
        )
        VALUES
        (
#{id}, #{userId}, #{token}, #{foreignId}, #{username}, #{loginIp}, #{updateTime}, #{expireTime}, #{createTime}, #{description}
        )
    </insert>

    <insert id="batchSave" parameterType="java.util.List">
        <choose>
            <when test='_databaseId == "mysql"'>
                INSERT INTO THIRD_MEMBER_TOKEN
                (
MEMBER_ID, USER_ID, TOKEN, FOREIGN_ID, USERNAME, LOGIN_IP, UPDATE_TIME, EXPIRE_TIME, CREATE_TIME, DESCRIPTION
                )
                VALUES
                <foreach collection="list" index="index" item="item" separator=",">
                    (
#{item.id}, #{item.userId}, #{item.token}, #{item.foreignId}, #{item.username}, #{item.loginIp}, #{item.updateTime}, #{item.expireTime}, #{item.createTime}, #{item.description}
                    )
                </foreach>
            </when>
            <otherwise>
                <foreach collection="list" item="item" index="index" open="begin" close=";end;" separator=";">
                    INSERT INTO THIRD_MEMBER_TOKEN
                    (
MEMBER_ID, USER_ID, TOKEN, FOREIGN_ID, USERNAME, LOGIN_IP, UPDATE_TIME, EXPIRE_TIME, CREATE_TIME, DESCRIPTION
                    )
                    VALUES
                    (
#{item.id}, #{item.userId}, #{item.token}, #{item.foreignId}, #{item.username}, #{item.loginIp}, #{item.updateTime}, #{item.expireTime}, #{item.createTime}, #{item.description}
                    )
                </foreach>
            </otherwise>
        </choose>
    </insert>

    <!-- update object，更新对象信息 -->
    <update id="update" parameterType="net.linlan.social.third.entity.ThirdMemberToken">
        UPDATE THIRD_MEMBER_TOKEN
        <set>
            <if test="userId != null">USER_ID = #{userId}, </if>
            <if test="token != null">TOKEN = #{token}, </if>
            <if test="foreignId != null">FOREIGN_ID = #{foreignId}, </if>
            <if test="username != null">USERNAME = #{username}, </if>
            <if test="loginIp != null">LOGIN_IP = #{loginIp}, </if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime}, </if>
            <if test="expireTime != null">EXPIRE_TIME = #{expireTime}, </if>
            <if test="createTime != null">CREATE_TIME = #{createTime}, </if>
            <if test="description != null">DESCRIPTION = #{description}</if>
        </set>
        WHERE MEMBER_ID = #{id}
    </update>

    <!-- delete by id，通过主键删除对象 -->
    <delete id="deleteById">
        DELETE FROM THIRD_MEMBER_TOKEN
        WHERE MEMBER_ID = #{value}
    </delete>

    <!-- delete by ids，通过主键数组批量删除对象 -->
    <delete id="deleteByIds">
        DELETE FROM THIRD_MEMBER_TOKEN
        WHERE MEMBER_ID IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- query total，通过输入的条件，查询返回结果的数量，返回值为int -->
    <select id="getCount" resultType="int">
        SELECT COUNT(1)
        FROM THIRD_MEMBER_TOKEN B
        WHERE 1 = 1
        <include refid="commonList"></include>
    </select>

    <!-- get list with dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <resultMap type="net.linlan.social.third.dto.ThirdMemberTokenDto" extends="thirdMemberTokenMap" id="thirdMemberTokenDtoMap">

    </resultMap>

    <!-- get page with param input dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <select id="getPageDto" resultMap="thirdMemberTokenDtoMap">
        SELECT
B.MEMBER_ID, B.USER_ID, B.TOKEN, B.FOREIGN_ID, B.USERNAME, B.LOGIN_IP, B.UPDATE_TIME, B.EXPIRE_TIME, B.CREATE_TIME, B.DESCRIPTION
        FROM THIRD_MEMBER_TOKEN B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>

    </select>

    <!-- get dto with input id，通过ID，查询dto对象 -->
    <select id="getDtoById" resultMap="thirdMemberTokenDtoMap">
        SELECT
B.MEMBER_ID, B.USER_ID, B.TOKEN, B.FOREIGN_ID, B.USERNAME, B.LOGIN_IP, B.UPDATE_TIME, B.EXPIRE_TIME, B.CREATE_TIME, B.DESCRIPTION
        FROM THIRD_MEMBER_TOKEN B
        WHERE MEMBER_ID = #{value}
    </select>

    <!-- 以下为新增特定的操作 -->
    <!-- get by token，通过Token获取对象 -->
    <select id="getByToken" resultMap="thirdMemberTokenMap">
        select * from THIRD_MEMBER_TOKEN where TOKEN = #{value}
    </select>

</mapper>
