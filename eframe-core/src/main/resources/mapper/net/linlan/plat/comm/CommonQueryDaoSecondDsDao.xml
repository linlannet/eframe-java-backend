<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.frame.comm.dao.CommonQuerySecondDsDao">

    <select id="executeSql" parameterType="String" resultType="map" statementType="STATEMENT">
        <![CDATA[
            ${value}
        ]]>
    </select>

    <select id="isExistsTable" resultType="Boolean">

        <choose>
            <when test='_databaseId == "mysql"'>
                SELECT EXISTS (
                SELECT 1
                FROM information_schema.tables
                WHERE table_name = ${tableName}
                ) AS isExists
            </when>
            <when test='_databaseId == "oracle"'>
                SELECT CASE
                WHEN COUNT(*) > 0 THEN '1'
                ELSE '0'
                END AS isExists
                FROM ALL_TABLES
                WHERE TABLE_NAME = UPPER(${tableName})
            </when>
            <otherwise>
                SELECT EXISTS (
                SELECT 1
                FROM information_schema.tables
                WHERE table_name = ${tableName}
                ) AS isExists
            </otherwise>
        </choose>

    </select>

    <select id="hasData" resultType="Boolean">
        SELECT CASE
                   WHEN EXISTS (SELECT 1 FROM ${tableName}) THEN 1
                   ELSE 0
                   END AS hasData
    </select>

</mapper>
