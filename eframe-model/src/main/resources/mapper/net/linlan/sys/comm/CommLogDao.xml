<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.sys.comm.dao.CommLogDao">

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.sys.comm.entity.CommLog" id="commLogMap">
        <id property="id" column="LOG_ID"/>
        <result property="appId" column="APP_ID"/>
        <result property="username" column="USERNAME"/>
        <result property="category" column="CATEGORY"/>
        <result property="operation" column="OPERATION"/>
        <result property="method" column="METHOD"/>
        <result property="params" column="PARAMS"/>
        <result property="srcCode" column="SRC_CODE"/>
        <result property="creatorId" column="CREATOR_ID"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="ip" column="IP"/>
        <result property="time" column="TIME"/>
        <result property="spare1" column="SPARE1"/>
        <result property="spare2" column="SPARE2"/>
    </resultMap>

    <!-- find by id，通过主键获取对象 -->
    <select id="findById" resultMap="commLogMap">
        SELECT
        LOG_ID, APP_ID, USERNAME, CATEGORY, OPERATION, METHOD, PARAMS, SRC_CODE, CREATOR_ID, CREATE_TIME, IP, TIME, SPARE1, SPARE2
        FROM COMM_LOG
        WHERE LOG_ID = #{value}
    </select>

    <!-- get list，通过输入的条件，获取返回的list列表对象，采用相应的分页规则进行分页处理 -->
    <select id="getList" resultMap="commLogMap">
        SELECT
        B.LOG_ID, B.APP_ID, B.CREATOR_ID, B.USERNAME, B.CATEGORY, B.OPERATION, B.METHOD, B.PARAMS, B.SRC_CODE, B.CREATE_TIME, B.IP, B.TIME, B.SPARE1, B.SPARE2
        FROM COMM_LOG B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>
    </select>


    <!-- 通用排序SQL，如果传入参数按照参数排序，如果未传入参数，按照主键排序 -->
    <sql id="getListOrderBy">
        <choose>
            <when test='orderBy != null'>
                ORDER BY LOG_ID ASC
            </when>
            <otherwise>
                ORDER BY LOG_ID DESC
            </otherwise>
        </choose>
    </sql>

    <!-- sql commonList 通过输入的条件，获取返回的list列表对象
    -->
    <sql id="commonList">
        <!--  只允许默认的本表的字段查询，查询条件可通过Param定义，默认全部字段，后续根据Param内的定义，可删除不需要的查询字段 -->
        <if test="appId != null and appId != ''">
            and B.APP_ID = #{appId}
        </if>
        <if test="username != null and username != ''">
            and B.USERNAME like concat('%',concat(#{username},'%'))
        </if>
        <if test="category != null and category != ''">
            and B.CATEGORY = #{category}
        </if>
        <if test="operation != null and operation != ''">
            and B.OPERATION like concat('%',concat(#{operation},'%'))
        </if>
        <if test="method != null and method != ''">
            and B.METHOD like concat('%',concat(#{method},'%'))
        </if>
        <if test="srcCode != null and srcCode != ''">
            and B.SRC_CODE = #{srcCode}
        </if>

        <if test="ip != null and ip != ''">
            and B.IP  like concat('%',concat(#{ip},'%'))
        </if>
        <if test="time != null and time != ''">
            and B.TIME = #{time}
        </if>
        <if test='q != null and q != ""'>
            and (B.OPERATION like concat('%',concat(#{q},'%'))
            or B.USERNAME like concat('%',concat(#{q},'%') ))
        </if>

        <!-- 各个数据库差异化的查询条件处理，如时间字段 -->
        <choose>
            <when test='_databaseId == "mysql"'>

            </when>
            <when test='_databaseId == "dm8" or _databaseId == "xg"'>

            </when>
            <otherwise>

            </otherwise>
        </choose>

    </sql>

    <!-- save object，保存对象信息 -->
    <insert id="save" parameterType="net.linlan.sys.comm.entity.CommLog">
        INSERT INTO COMM_LOG
        (
            LOG_ID, APP_ID, USERNAME, CATEGORY, OPERATION, METHOD, PARAMS, SRC_CODE, CREATOR_ID, CREATE_TIME, IP, TIME, SPARE1, SPARE2
        )
        VALUES
        (
            #{id}, #{appId}, #{username}, #{category}, #{operation}, #{method}, #{params}, #{srcCode}, #{creatorId}, #{createTime}, #{ip}, #{time}, #{spare1}, #{spare2}
        )
    </insert>

    <insert id="batchSave" parameterType="java.util.List">
        <choose>
            <when test='_databaseId == "mysql"'>
                INSERT INTO COMM_LOG
                (
                LOG_ID, APP_ID, USERNAME, CATEGORY, OPERATION, METHOD, PARAMS, SRC_CODE, CREATOR_ID, CREATE_TIME, IP, TIME, SPARE1, SPARE2
                )
                VALUES
                <foreach collection="list" index="index" item="item" separator=",">
                    (
                    #{item.id}, #{item.appId}, #{item.username}, #{item.category}, #{item.operation}, #{item.method}, #{item.params}, #{item.srcCode}, #{item.creatorId}, #{item.createTime}, #{item.ip}, #{item.time}, #{item.spare1}, #{item.spare2}
                    )
                </foreach>
            </when>
            <otherwise>
                <foreach collection="list" item="item" index="index" open="begin" close=";end;" separator=";">
                    INSERT INTO COMM_LOG
                    (
                    LOG_ID, APP_ID, USERNAME, CATEGORY, OPERATION, METHOD, PARAMS, SRC_CODE, CREATOR_ID, CREATE_TIME, IP, TIME, SPARE1, SPARE2
                    )
                    VALUES
                    (
                    #{item.id}, #{item.appId}, #{item.username}, #{item.category}, #{item.operation}, #{item.method}, #{item.params}, #{item.srcCode}, #{item.creatorId}, #{item.createTime}, #{item.ip}, #{item.time}, #{item.spare1}, #{item.spare2}
                    )
                </foreach>
            </otherwise>
        </choose>
    </insert>

    <!-- update object，更新对象信息 -->
    <update id="update" parameterType="net.linlan.sys.comm.entity.CommLog">
        UPDATE COMM_LOG
        <set>
            <if test="appId != null">APP_ID = #{appId}, </if>
            <if test="username != null">USERNAME = #{username}, </if>
            <if test="category != null">"CATEGORY" = #{category}, </if>
            <if test="operation != null">OPERATION = #{operation}, </if>
            <if test="method != null">METHOD = #{method}, </if>
            <if test="params != null">PARAMS = #{params}, </if>
            <if test="srcCode != null">SRC_CODE = #{srcCode}, </if>
            <if test="ip != null">IP = #{ip}, </if>
            <if test="time != null">"TIME" = #{time}, </if>
            <if test="spare1 != null">SPARE1 = #{spare1}, </if>
            <if test="spare2 != null">SPARE2 = #{spare2}</if>
        </set>
        WHERE LOG_ID = #{id}
    </update>

    <!-- delete by id，通过主键删除对象 -->
    <delete id="deleteById">
        DELETE FROM COMM_LOG
        WHERE LOG_ID = #{value}
    </delete>

    <!-- delete by ids，通过主键数组批量删除对象 -->
    <delete id="deleteByIds">
        DELETE FROM COMM_LOG
        WHERE LOG_ID IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- query total，通过输入的条件，查询返回结果的数量，返回值为int -->
    <select id="getCount" resultType="int">
        SELECT COUNT(1)
        FROM COMM_LOG B
        WHERE 1 = 1
        <include refid="commonList"></include>
    </select>

    <!-- 以下为新增特定的操作 -->
    <!-- get list with dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <resultMap type="net.linlan.sys.comm.dto.CommLogDto" extends="commLogMap" id="commLogDtoMap">

    </resultMap>

    <!-- get page with param input dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <select id="getPageDto" resultMap="commLogDtoMap">
        SELECT
        B.LOG_ID, B.APP_ID, B.USERNAME, B.CATEGORY, B.OPERATION, B.METHOD, B.PARAMS, B.SRC_CODE, B.CREATOR_ID, B.CREATE_TIME, B.IP, B.TIME, B.SPARE1, B.SPARE2
        FROM COMM_LOG B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>

    </select>

    <!-- get dto with input id，通过ID，查询dto对象 -->
    <select id="getDtoById" resultMap="commLogDtoMap">
        SELECT
        LOG_ID, APP_ID, USERNAME, CATEGORY, OPERATION, METHOD, PARAMS, SRC_CODE, CREATOR_ID, CREATE_TIME, IP, TIME, SPARE1, SPARE2
        FROM COMM_LOG
        WHERE LOG_ID = #{value}
    </select>


</mapper>
