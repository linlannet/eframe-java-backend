<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.sys.base.dao.BaseConfigWholeDao">

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.sys.base.entity.BaseConfigWhole" id="baseConfigWholeMap">
        <id property="id" column="CFG_ID"/>
        <result property="cfgKey" column="CFG_KEY"/>
        <result property="cfgValue" column="CFG_VALUE"/>
        <result property="cfgCatagory" column="CFG_CATAGORY"/>
        <result property="isDisabled" column="IS_DISABLED"/>
        <result property="description" column="DESCRIPTION"/>
    </resultMap>

    <!-- find by id，通过主键获取对象 -->
    <select id="findById" resultMap="baseConfigWholeMap">
        SELECT
        CFG_ID, CFG_KEY, CFG_VALUE, CFG_CATAGORY, IS_DISABLED, DESCRIPTION
        FROM BASE_CONFIG_WHOLE
        WHERE CFG_ID = #{value}
    </select>

    <!-- get list，通过输入的条件，获取返回的list列表对象，采用相应的分页规则进行分页处理 -->
    <select id="getList" resultMap="baseConfigWholeMap">
        SELECT
        B.CFG_ID, B.CFG_KEY, B.CFG_VALUE, B.CFG_CATAGORY, B.IS_DISABLED, B.DESCRIPTION
        FROM BASE_CONFIG_WHOLE B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>
    </select>


    <!-- 通用排序SQL，如果传入参数按照参数排序，如果未传入参数，按照主键排序 -->
    <sql id="getListOrderBy">
        <choose>
            <when test='orderBy != null'>
                <choose>
                    <when test='orderBy == 1'>
                        ORDER BY B.CFG_KEY DESC
                    </when>
                    <when test='orderBy == 2'>
                        ORDER BY B.CFG_KEY ASC
                    </when>
                    <otherwise>
                        ORDER BY CFG_ID ASC
                    </otherwise>
                </choose>
            </when>
            <otherwise>
                ORDER BY CFG_ID DESC
            </otherwise>
        </choose>
    </sql>

    <!-- sql commonList 通过输入的条件，获取返回的list列表对象
    -->
    <sql id="commonList">
        <!--  只允许默认的本表的字段查询，查询条件可通过Param定义，默认全部字段，后续根据Param内的定义，可删除不需要的查询字段 -->
        <if test='id != null and id !=""'>
            and B.CFG_ID like concat(#{id},'%')
        </if>
        <if test='cfgId != null and cfgId !=""'>
            and B.CFG_ID = #{cfgId}
        </if>
        <if test='cfgKey != null and cfgKey !=""'>
            and B.CFG_KEY like concat(#{cfgKey},'%')
        </if>
        <if test='q != null and q !=""'>
            and B.CFG_KEY like concat('%',concat(#{q},'%'))
        </if>
        <if test="cfgValue != null and cfgValue != ''">
            and B.CFG_VALUE = #{cfgValue}
        </if>
        <if test="cfgCatagory != null and cfgCatagory != ''">
            and B.CFG_CATAGORY = #{cfgCatagory}
        </if>
        <if test="isDisabled != null">
            and B.IS_DISABLED = #{isDisabled}
        </if>
        <if test="description != null and description != ''">
            and B.DESCRIPTION like concat('%',concat(#{description},'%'))
        </if>

        <!-- 各个数据库差异化的查询条件处理，如时间字段 -->
        <choose>
            <when test='_databaseId == "mysql"'>
                <if test='startTime != null and  startTime.trim() != "" and endTime != null and  endTime.trim() != "" '>
                    <![CDATA[ and   date_format(B.CFG_KEY,'%Y-%m-%d')>=date_format(#{startTime},'%Y-%m-%d')
                        and date_format(B.CFG_KEY,'%Y-%m-%d') <= date_format(#{endTime},'%Y-%m-%d') ]]>
                </if>
            </when>
            <when test='_databaseId == "dm8"'>
                <if test='startTime != null and  startTime.trim() != "" and endTime != null and  endTime.trim() != "" '>
                    <![CDATA[ and   date_format(B.CFG_KEY,'%Y-%m-%d')>=date_format(#{startTime},'%Y-%m-%d')
                        and date_format(B.CFG_KEY,'%Y-%m-%d') <= date_format(#{endTime},'%Y-%m-%d') ]]>
                </if>
            </when>
            <otherwise>

            </otherwise>
        </choose>

    </sql>

    <!-- save object，保存对象信息 -->
    <insert id="save" parameterType="net.linlan.sys.base.entity.BaseConfigWhole">
        INSERT INTO BASE_CONFIG_WHOLE
        (
            CFG_ID, CFG_KEY, CFG_VALUE, CFG_CATAGORY, IS_DISABLED, DESCRIPTION
        )
        VALUES
        (
            #{id}, #{cfgKey}, #{cfgValue}, #{cfgCatagory}, #{isDisabled}, #{description}
        )
    </insert>

    <insert id="batchSave" parameterType="java.util.List">
        <choose>
            <when test='_databaseId == "mysql"'>
                INSERT INTO BASE_CONFIG_WHOLE
                (
                CFG_ID, CFG_KEY, CFG_VALUE, CFG_CATAGORY, IS_DISABLED, DESCRIPTION
                )
                VALUES
                <foreach collection="list" index="index" item="item" separator=",">
                    (
                    #{item.id}, #{item.cfgKey}, #{item.cfgValue}, #{item.cfgCatagory}, #{item.isDisabled}, #{item.description}
                    )
                </foreach>
            </when>
            <otherwise>
                <foreach collection="list" item="item" index="index" open="begin" close=";end;" separator=";">
                    INSERT INTO BASE_CONFIG_WHOLE
                    (
                    CFG_ID, CFG_KEY, CFG_VALUE, CFG_CATAGORY, IS_DISABLED, DESCRIPTION
                    )
                    VALUES
                    (
                    #{item.id}, #{item.cfgKey}, #{item.cfgValue}, #{item.cfgCatagory}, #{item.isDisabled}, #{item.description}
                    )
                </foreach>
            </otherwise>
        </choose>
    </insert>

    <!-- update object，更新对象信息 -->
    <update id="update" parameterType="net.linlan.sys.base.entity.BaseConfigWhole">
        UPDATE BASE_CONFIG_WHOLE
        <set>
            <if test="cfgKey != null">CFG_KEY = #{cfgKey}, </if>
            <if test="cfgValue != null">CFG_VALUE = #{cfgValue}, </if>
            <if test="cfgCatagory != null">CFG_CATAGORY = #{cfgCatagory}, </if>
            <if test="isDisabled != null">IS_DISABLED = #{isDisabled}, </if>
            <if test="description != null">DESCRIPTION = #{description}</if>
        </set>
        WHERE CFG_ID = #{id}
    </update>

    <!-- delete by id，通过主键删除对象 -->
    <delete id="deleteById">
        DELETE FROM BASE_CONFIG_WHOLE
        WHERE CFG_ID = #{value}
    </delete>

    <!-- delete by ids，通过主键数组批量删除对象 -->
    <delete id="deleteByIds">
        DELETE FROM BASE_CONFIG_WHOLE
        WHERE CFG_ID IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- query total，通过输入的条件，查询返回结果的数量，返回值为int -->
    <select id="getCount" resultType="int">
        SELECT COUNT(1)
        FROM BASE_CONFIG_WHOLE B
        WHERE 1 = 1
        <include refid="commonList"></include>
    </select>

    <!-- 以下为新增特定的操作 -->
    <!-- get list with dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <resultMap type="net.linlan.sys.base.dto.BaseConfigWholeDto" extends="baseConfigWholeMap" id="baseConfigWholeDtoMap">

    </resultMap>

    <!-- get page with param input dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <select id="getPageDto" resultMap="baseConfigWholeDtoMap">
        SELECT
        B.CFG_ID, B.CFG_KEY, B.CFG_VALUE, B.CFG_CATAGORY, B.IS_DISABLED, B.DESCRIPTION
        FROM BASE_CONFIG_WHOLE B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>

    </select>

    <!-- get dto with input id，通过ID，查询dto对象 -->
    <select id="getDtoById" resultMap="baseConfigWholeDtoMap">
        SELECT
        B.CFG_ID, B.CFG_KEY, B.CFG_VALUE, B.CFG_CATAGORY, B.IS_DISABLED, B.DESCRIPTION
        FROM BASE_CONFIG_WHOLE B
        WHERE CFG_ID = #{value}
    </select>

    <select id="getConfigs" resultMap="baseConfigWholeMap">
        select * from BASE_CONFIG_WHOLE where CFG_KEY=#{key} and DESCRIPTION=#{description}
        <choose>
            <when test='_databaseId == "mysql"'>
                LIMIT 1
            </when>
            <when test='_databaseId == "dm8" or _databaseId == "xg"'>
                LIMIT 1
            </when>
            <otherwise>
                AND rownum&lt;=1
            </otherwise>
        </choose>
    </select>

    <!-- 根据key，更新value -->
    <update id="updateValueByKey" parameterType="map">
        update BASE_CONFIG_WHOLE set CFG_VALUE = #{value} where CFG_KEY = #{key}
    </update>

    <select id="getByIds" parameterType="string" resultMap="baseConfigWholeMap">
        select * from BASE_CONFIG_WHOLE where CFG_ID IN
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 根据key，查询value -->
    <select id="getByKey" parameterType="string" resultMap="baseConfigWholeMap">
        select * from BASE_CONFIG_WHOLE where CFG_KEY = #{cfg_key}
    </select>

    <select id="getByKeys" parameterType="string" resultMap="baseConfigWholeMap">
        select * from BASE_CONFIG_WHOLE where CFG_KEY IN
        <foreach item="key" collection="keys" open="(" separator="," close=")">
            #{key}
        </foreach>
    </select>

    <!-- 根据key，查询value -->
    <select id="getByKeyLike" parameterType="string" resultMap="baseConfigWholeMap">
        select * from BASE_CONFIG_WHOLE where CFG_KEY like concat('%',concat(#{key},'%'))
    </select>

    <delete id="deleteByKey">
        DELETE FROM BASE_CONFIG_WHOLE
        WHERE CFG_KEY = #{key}
    </delete>

    <delete id="deleteByKeys">
        DELETE FROM BASE_CONFIG_WHOLE
        WHERE CFG_KEY IN
        <foreach item="key" collection="keys" open="(" separator="," close=")">
            #{key}
        </foreach>
    </delete>

    <!-- 根据cfgCategory查询列表 -->
    <select id="getByCfgCategory" parameterType="string" resultMap="baseConfigWholeMap">
        select * from BASE_CONFIG_WHOLE where CFG_CATAGORY = #{cfgCategory}
    </select>

</mapper>
