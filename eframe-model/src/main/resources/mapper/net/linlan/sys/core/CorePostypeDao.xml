<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.sys.core.dao.CorePostypeDao">

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.sys.core.entity.CorePostype" id="corePostypeMap">
        <id property="id" column="POSTYPE_ID"/>
        <result property="name" column="NAME"/>
        <result property="sname" column="SNAME"/>
        <result property="priority" column="PRIORITY"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="lastTime" column="LAST_TIME"/>
        <result property="delFlag" column="DEL_FLAG"/>
        <result property="description" column="DESCRIPTION"/>
    </resultMap>

    <!-- find by id，通过主键获取对象 -->
    <select id="findById" resultMap="corePostypeMap">
        SELECT
        POSTYPE_ID, NAME, SNAME, PRIORITY, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION
        FROM CORE_POSTYPE
        WHERE POSTYPE_ID = #{value}
    </select>

    <!-- get list，通过输入的条件，获取返回的list列表对象，采用相应的分页规则进行分页处理 -->
    <select id="getList" resultMap="corePostypeMap">
        SELECT
        B.POSTYPE_ID, B.NAME, B.SNAME, B.PRIORITY, B.CREATE_TIME, B.LAST_TIME, B.DEL_FLAG, B.DESCRIPTION
        FROM CORE_POSTYPE B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>
    </select>


    <!-- 通用排序SQL，如果传入参数按照参数排序，如果未传入参数，按照主键排序 -->
    <sql id="getListOrderBy">
        <choose>
            <when test='orderBy != null'>
                ORDER BY POSTYPE_ID ASC
            </when>
            <otherwise>
                ORDER BY POSTYPE_ID DESC
            </otherwise>
        </choose>
    </sql>

    <!-- sql commonList 通过输入的条件，获取返回的list列表对象
    -->
    <sql id="commonList">
        <!--  只允许默认的本表的字段查询，查询条件可通过Param定义，默认全部字段，后续根据Param内的定义，可删除不需要的查询字段 -->
        <if test="name != null and name != ''">
            and B.NAME = #{name}
        </if>
        <if test="sname != null and sname != ''">
            and B.SNAME = #{sname}
        </if>
        <choose>
            <when test="delFlag != null">
                AND B.DEL_FLAG = #{delFlag}
            </when>
            <otherwise>
                AND B.DEL_FLAG = 0
            </otherwise>
        </choose>
        <if test="description != null and description != ''">
            and B.DESCRIPTION = #{description}
        </if>
        <if test='key != null and key !=""'>
            AND  (
            B.NAME like concat('%',concat(#{key},'%'))
            )
        </if>
        <if test='q != null and q !=""'>
            AND  (
            B.NAME like concat('%',concat(#{q},'%'))
            )
        </if>

        <!-- 各个数据库差异化的查询条件处理，如时间字段 -->
        <choose>
            <when test='_databaseId == "mysql"'>

            </when>
            <when test='_databaseId == "dm8" or _databaseId == "xg"'>

            </when>
            <otherwise>

            </otherwise>
        </choose>

    </sql>

    <!-- save object，保存对象信息 -->
    <insert id="save" parameterType="net.linlan.sys.core.entity.CorePostype">
        INSERT INTO CORE_POSTYPE
        (
        POSTYPE_ID, NAME, SNAME, PRIORITY, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION
        )
        VALUES
        (
        #{id}, #{name}, #{sname}, #{priority}, #{createTime}, #{lastTime}, #{delFlag}, #{description}
        )
    </insert>

    <insert id="batchSave" parameterType="java.util.List">
        <choose>
            <when test='_databaseId == "mysql"'>
                INSERT INTO CORE_POSTYPE
                (
                POSTYPE_ID, NAME, SNAME, PRIORITY, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION
                )
                VALUES
                <foreach collection="list" index="index" item="item" separator=",">
                    (
                    #{item.id}, #{item.name}, #{item.sname}, #{item.priority}, #{item.createTime}, #{item.lastTime}, #{item.delFlag}, #{item.description}
                    )
                </foreach>
            </when>
            <otherwise>
                <foreach collection="list" item="item" index="index" open="begin" close=";end;" separator=";">
                    INSERT INTO CORE_POSTYPE
                    (
                    POSTYPE_ID, NAME, SNAME, PRIORITY, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION
                    )
                    VALUES
                    (
                    #{item.id}, #{item.name}, #{item.sname}, #{item.priority}, #{item.createTime}, #{item.lastTime}, #{item.delFlag}, #{item.description}
                    )
                </foreach>
            </otherwise>
        </choose>
    </insert>

    <!-- update object，更新对象信息 -->
    <update id="update" parameterType="net.linlan.sys.core.entity.CorePostype">
        UPDATE CORE_POSTYPE
        <set>
            <if test="name != null">NAME = #{name}, </if>
            <if test="sname != null">SNAME = #{sname}, </if>
            <if test="priority != null">PRIORITY = #{priority}, </if>
            <if test="createTime != null">CREATE_TIME = #{createTime}, </if>
            <if test="lastTime != null">LAST_TIME = #{lastTime}, </if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag}, </if>
            <if test="description != null">DESCRIPTION = #{description}</if>
        </set>
        WHERE POSTYPE_ID = #{id}
    </update>

    <!-- delete by id，通过主键删除对象 -->
    <delete id="deleteById">
        DELETE FROM CORE_POSTYPE
        WHERE POSTYPE_ID = #{value}
    </delete>

    <!-- delete by ids，通过主键数组批量删除对象 -->
    <delete id="deleteByIds">
        DELETE FROM CORE_POSTYPE
        WHERE POSTYPE_ID IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- query total，通过输入的条件，查询返回结果的数量，返回值为int -->
    <select id="getCount" resultType="int">
        SELECT COUNT(1)
        FROM CORE_POSTYPE B
        WHERE 1 = 1
        <include refid="commonList"></include>
    </select>

    <!-- 以下为新增特定的操作 -->
    <!-- get list with dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <resultMap type="net.linlan.sys.core.dto.CorePostypeDto" extends="corePostypeMap" id="corePostypeDtoMap">

    </resultMap>

    <!-- get page with param input dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <select id="getPageDto" resultMap="corePostypeDtoMap">
        SELECT
        B.POSTYPE_ID, B.NAME, B.SNAME, B.PRIORITY, B.CREATE_TIME, B.LAST_TIME, B.DEL_FLAG, B.DESCRIPTION
        FROM CORE_POSTYPE B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>

    </select>

    <!-- get dto with input id，通过ID，查询dto对象 -->
    <select id="getDtoById" resultMap="corePostypeDtoMap">
        SELECT
        POSTYPE_ID, NAME, SNAME, PRIORITY, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION
        FROM CORE_POSTYPE
        WHERE POSTYPE_ID = #{value}
    </select>


</mapper>
