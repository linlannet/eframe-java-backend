<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.sys.core.dao.CoreOrgtypeDao">

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.sys.core.entity.CoreOrgtype" id="coreOrgtypeMap">
        <id property="id" column="ORGTYPE_ID"/>
        <result property="parentId" column="PARENT_ID"/>
        <result property="code" column="CODE"/>
        <result property="name" column="NAME"/>
        <result property="sname" column="SNAME"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="lastTime" column="LAST_TIME"/>
        <result property="priority" column="PRIORITY"/>
        <result property="delFlag" column="DEL_FLAG"/>
        <result property="description" column="DESCRIPTION"/>
    </resultMap>

    <!-- find by id，通过主键获取对象 -->
    <select id="findById" resultMap="coreOrgtypeMap">
        SELECT
        ORGTYPE_ID, PARENT_ID, CODE, NAME, SNAME, CREATE_TIME, LAST_TIME, PRIORITY, DEL_FLAG, DESCRIPTION
        FROM CORE_ORGTYPE
        WHERE ORGTYPE_ID = #{value}
    </select>

    <!-- get list，通过输入的条件，获取返回的list列表对象，采用相应的分页规则进行分页处理 -->
    <select id="getList" resultMap="coreOrgtypeMap">
        SELECT
        B.ORGTYPE_ID, B.PARENT_ID, B.CODE, B.NAME, B.SNAME, B.CREATE_TIME, B.LAST_TIME, B.PRIORITY, B.DEL_FLAG, B.DESCRIPTION
        FROM CORE_ORGTYPE B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>
    </select>


    <!-- 通用排序SQL，如果传入参数按照参数排序，如果未传入参数，按照主键排序 -->
    <sql id="getListOrderBy">
        <choose>
            <when test='orderBy != null'>
                ORDER BY ORGTYPE_ID ASC
            </when>
            <otherwise>
                ORDER BY ORGTYPE_ID DESC
            </otherwise>
        </choose>
    </sql>

    <!-- sql commonList 通过输入的条件，获取返回的list列表对象
    -->
    <sql id="commonList">
        <!--  只允许默认的本表的字段查询，查询条件可通过Param定义，默认全部字段，后续根据Param内的定义，可删除不需要的查询字段 -->
        <if test="parentId != null and parentId != ''">
            and B.PARENT_ID = #{parentId}
        </if>
        <if test="code != null and code != ''">
            and B.CODE = #{code}
        </if>
        <if test="name != null and name != ''">
            and B.NAME like concat('%',#{name},'%')
        </if>
        <if test="sname != null and sname != ''">
            and B.SNAME like concat('%',#{sname},'%')
        </if>
        <choose>
            <when test="delFlag != null">
                AND B.DEL_FLAG = #{delFlag}
            </when>
            <otherwise>
                AND B.DEL_FLAG = 0
            </otherwise>
        </choose>
        <if test="description != null and description != ''">
            and B.DESCRIPTION = #{description}
        </if>
        <if test='key != null and key.trim() != ""'>
            and (B.NAME like concat('%',concat(#{key},'%')
            or B.SNAME like concat('%',concat(#{key},'%')
            or B.CODE like concat('%',concat(#{key},'%') )
        </if>

        <!-- 各个数据库差异化的查询条件处理，如时间字段 -->
        <choose>
            <when test='_databaseId == "mysql"'>

            </when>
            <when test='_databaseId == "dm8" or _databaseId == "xg"'>

            </when>
            <otherwise>

            </otherwise>
        </choose>

    </sql>

    <!-- save object，保存对象信息 -->
    <insert id="save" parameterType="net.linlan.sys.core.entity.CoreOrgtype">
        INSERT INTO CORE_ORGTYPE
        (
        ORGTYPE_ID, PARENT_ID, CODE, NAME, SNAME, CREATE_TIME, LAST_TIME, PRIORITY, DEL_FLAG, DESCRIPTION
        )
        VALUES
        (
        #{id}, #{parentId}, #{code}, #{name}, #{sname}, #{createTime}, #{lastTime}, #{priority}, #{delFlag}, #{description}
        )
    </insert>

    <insert id="batchSave" parameterType="java.util.List">
        <choose>
            <when test='_databaseId == "mysql"'>
                INSERT INTO CORE_ORGTYPE
                (
                ORGTYPE_ID, PARENT_ID, CODE, NAME, SNAME, CREATE_TIME, LAST_TIME, PRIORITY, DEL_FLAG, DESCRIPTION
                )
                VALUES
                <foreach collection="list" index="index" item="item" separator=",">
                    (
                    #{item.id}, #{item.parentId}, #{item.code}, #{item.name}, #{item.sname}, #{item.createTime}, #{item.lastTime}, #{item.priority}, #{item.delFlag}, #{item.description}
                    )
                </foreach>
            </when>
            <otherwise>
                <foreach collection="list" item="item" index="index" open="begin" close=";end;" separator=";">
                    INSERT INTO CORE_ORGTYPE
                    (
                    ORGTYPE_ID, PARENT_ID, CODE, NAME, SNAME, CREATE_TIME, LAST_TIME, PRIORITY, DEL_FLAG, DESCRIPTION
                    )
                    VALUES
                    (
                    #{item.id}, #{item.parentId}, #{item.code}, #{item.name}, #{item.sname}, #{item.createTime}, #{item.lastTime}, #{item.priority}, #{item.delFlag}, #{item.description}
                    )
                </foreach>
            </otherwise>
        </choose>
    </insert>

    <!-- update object，更新对象信息 -->
    <update id="update" parameterType="net.linlan.sys.core.entity.CoreOrgtype">
        UPDATE CORE_ORGTYPE
        <set>
            <if test="parentId != null">PARENT_ID = #{parentId}, </if>
            <if test="code != null">CODE = #{code}, </if>
            <if test="name != null">NAME = #{name}, </if>
            <if test="sname != null">SNAME = #{sname}, </if>
            <if test="createTime != null">CREATE_TIME = #{createTime}, </if>
            <if test="lastTime != null">LAST_TIME = #{lastTime}, </if>
            <if test="priority != null">PRIORITY = #{priority}, </if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag}, </if>
            <if test="description != null">DESCRIPTION = #{description}</if>
        </set>
        WHERE ORGTYPE_ID = #{id}
    </update>

    <!-- delete by id，通过主键删除对象 -->
    <update id="deleteById">
        <choose>
            <when test='_databaseId == "mysql"'>
                update CORE_ORGTYPE set DEL_FLAG = 1, LAST_TIME = sysdate() WHERE ORGTYPE_ID = #{value}
            </when>
            <when test='_databaseId == "dm8" or _databaseId == "xg"'>
                update CORE_ORGTYPE set DEL_FLAG = 1, LAST_TIME = sysdate() WHERE ORGTYPE_ID = #{value}
            </when>
            <otherwise>
                update CORE_ORGTYPE set DEL_FLAG = 1, LAST_TIME = sysdate() WHERE ORGTYPE_ID = #{value}
            </otherwise>
        </choose>
    </update>

    <!-- delete by ids，通过主键数组批量删除对象 -->
    <update id="deleteByIds">
        <choose>
            <when test='_databaseId == "mysql"'>
                update CORE_ORGTYPE set DEL_FLAG = 1, LAST_TIME = sysdate()
                WHERE ORGTYPE_ID IN
                <foreach item="id" collection="array" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <when test='_databaseId == "dm8" or _databaseId == "xg"'>
                update CORE_ORGTYPE set DEL_FLAG = 1, LAST_TIME = sysdate()
                WHERE ORGTYPE_ID IN
                <foreach item="id" collection="array" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                update CORE_ORGTYPE set DEL_FLAG = 1, LAST_TIME = sysdate()
                WHERE ORGTYPE_ID IN
                <foreach item="id" collection="array" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </otherwise>
        </choose>
    </update>
    <!-- query total，通过输入的条件，查询返回结果的数量，返回值为int -->
    <select id="getCount" resultType="int">
        SELECT COUNT(1)
        FROM CORE_ORGTYPE B
        WHERE 1 = 1
        <include refid="commonList"></include>
    </select>

    <!-- 以下为新增特定的操作 -->
    <!-- get list with dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <resultMap type="net.linlan.sys.core.dto.CoreOrgtypeDto" extends="coreOrgtypeMap" id="coreOrgtypeDtoMap">
        <result property="parentName" column="parentName"/>

    </resultMap>

    <!-- get page with param input dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <select id="getPageDto" resultMap="coreOrgtypeDtoMap">
        SELECT
        B.ORGTYPE_ID, B.PARENT_ID, B.CODE, B.NAME, B.SNAME, B.CREATE_TIME, B.LAST_TIME, B.PRIORITY, B.DEL_FLAG, B.DESCRIPTION
        , X.NAME AS parentName
        FROM CORE_ORGTYPE B
        <include refid="commonUnionJoin"></include>
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>

    </select>

    <sql id="commonUnionJoin">
        left join CORE_ORGTYPE X on B.PARENT_ID = X.ORGTYPE_ID
    </sql>

    <!-- get dto with input id，通过ID，查询dto对象 -->
    <select id="getDtoById" resultMap="coreOrgtypeDtoMap">
        SELECT
        B.ORGTYPE_ID, B.PARENT_ID, B.CODE, B.NAME, B.SNAME, B.CREATE_TIME, B.LAST_TIME, B.PRIORITY, B.DEL_FLAG, B.DESCRIPTION
        , X.NAME AS parentName
        FROM CORE_ORGTYPE B
        <include refid="commonUnionJoin"></include>
        WHERE B.ORGTYPE_ID = #{value}
    </select>

    <resultMap id="treeNodeMap" type="net.linlan.sys.base.dto.TreeNode">
        <id property="id" column="id"/>
        <result property="label" column="label"/>
        <result property="searchCode" column="searchCode"/>
        <result property="childNum" column="childNum"/>
    </resultMap>

    <select id="getOrgTypeChildren" resultMap="treeNodeMap">
        select B.ORGTYPE_ID as id, B.NAME as label, B.CODE as searchCode,
        (SELECT COUNT(A.ORGTYPE_ID) FROM CORE_ORGTYPE A WHERE A.PARENT_ID = B.ORGTYPE_ID) AS childNum
        from CORE_ORGTYPE B
        where 1 = 1
        <choose>
            <when test="parentId != null and parentId != ''">
                AND B.PARENT_ID = #{parentId}
            </when>
            <otherwise>
                AND (B.PARENT_ID IS NULL OR B.PARENT_ID = 0 OR B.PARENT_ID = '')
            </otherwise>
        </choose>
        ORDER BY B.PRIORITY,B.ORGTYPE_ID ASC
    </select>

    <select id="getAllSelectList" resultMap="coreOrgtypeDtoMap">
        SELECT B.ORGTYPE_ID, B.NAME, B.SNAME
        FROM CORE_ORGTYPE B
        where B.DEL_FLAG = 0
        <if test='name != null and name.trim() != ""'>
            and B.NAME like concat('%',#{name},'%')
        </if>
        <if test='sname != null and sname.trim() != ""'>
            and B.SNAME like concat('%',#{sname},'%')
        </if>
    </select>


</mapper>
