<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.sys.base.dao.BaseOrganDao">

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.sys.base.entity.BaseOrgan" id="baseOrganMap">
        <id property="id" column="ORGAN_ID"/>
        <result property="xzqhId" column="XZQH_ID"/>
        <result property="name" column="NAME"/>
        <result property="source" column="SOURCE"/>
        <result property="unionCode" column="UNION_CODE"/>
        <result property="organCode" column="ORGAN_CODE"/>
        <result property="createType" column="CREATE_TYPE"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="lastTime" column="LAST_TIME"/>
        <result property="priority" column="PRIORITY"/>
        <result property="delFlag" column="DEL_FLAG"/>
        <result property="deleteTime" column="DELETE_TIME"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="spare1" column="SPARE1"/>
        <result property="spare2" column="SPARE2"/>
    </resultMap>

    <!-- 增加扩展类的BaseOrgan对象 -->
    <resultMap type="net.linlan.sys.base.entity.BaseOrgan" id="baseOrganMoreMap" extends="baseOrganMap">
        <association property="baseOrganExt" column="{value=ORGAN_ID}" select="net.linlan.sys.base.dao.BaseOrganExtDao.findById"></association>
    </resultMap>

    <!-- find by id，通过主键获取对象 -->
    <select id="findById" resultMap="baseOrganMoreMap">
        SELECT
        ORGAN_ID, XZQH_ID, NAME, SOURCE, UNION_CODE, ORGAN_CODE, CREATE_TYPE, CREATE_TIME, LAST_TIME, PRIORITY, DEL_FLAG, DELETE_TIME, DESCRIPTION, SPARE1, SPARE2
        FROM BASE_ORGAN
        WHERE ORGAN_ID = #{value}
    </select>

    <!-- get list，通过输入的条件，获取返回的list列表对象，采用相应的分页规则进行分页处理 -->
    <select id="getList" resultMap="baseOrganMap">
        SELECT
        B.ORGAN_ID, B.XZQH_ID, B.NAME, B.SOURCE, B.UNION_CODE, B.ORGAN_CODE, B.CREATE_TYPE, B.CREATE_TIME, B.LAST_TIME, B.PRIORITY, B.DEL_FLAG, B.DELETE_TIME, B.DESCRIPTION, B.SPARE1, B.SPARE2
        FROM BASE_ORGAN B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>
    </select>


    <!-- 通用排序SQL，如果传入参数按照参数排序，如果未传入参数，按照主键排序 -->
    <sql id="getListOrderBy">
        <choose>
            <when test='orderBy != null'>
                <choose>
                    <when test='orderBy == 0'>
                        ORDER BY B.PRIORITY DESC
                    </when>
                    <when test='orderBy == 1'>
                        ORDER BY B.PRIORITY ASC
                    </when>
                    <when test='orderBy == 2'>
                        ORDER BY B.CREATE_TIME DESC
                    </when>
                    <when test='orderBy == 3'>
                        ORDER BY B.CREATE_TIME ASC
                    </when>
                    <when test='orderBy == 4'>
                        ORDER BY B.XZQH_ID DESC
                    </when>
                    <when test='orderBy == 5'>
                        ORDER BY B.XZQH_ID ASC
                    </when>
                    <otherwise>
                        ORDER BY ORGAN_ID DESC
                    </otherwise>
                </choose>
            </when>
            <otherwise>
                ORDER BY ORGAN_ID DESC
            </otherwise>
        </choose>
    </sql>

    <!-- sql commonList 通过输入的条件，获取返回的list列表对象
    -->
    <sql id="commonList">
        <!--  只允许默认的本表的字段查询，查询条件可通过Param定义，默认全部字段，后续根据Param内的定义，可删除不需要的查询字段 -->
        <if test="xzqhId != null and xzqhId != ''">
            and B.XZQH_ID = #{xzqhId}
        </if>
        <if test="name != null and name != ''">
            and B.NAME = #{name}
        </if>
        <if test="source != null and source != ''">
            and B.SOURCE = #{source}
        </if>
        <if test="unionCode != null and unionCode != ''">
            and B.UNION_CODE = #{unionCode}
        </if>
        <if test="organCode != null and organCode != ''">
            and B.ORGAN_CODE = #{organCode}
        </if>
        <if test="createType != null and createType != ''">
            and B.CREATE_TYPE = #{createType}
        </if>
        <choose>
            <when test="delFlag != null">
                AND B.DEL_FLAG = #{delFlag}
            </when>
            <otherwise>
                AND B.DEL_FLAG = 0
            </otherwise>
        </choose>
        <choose>
            <when test="delFlag != null">
                AND B.DEL_FLAG = #{delFlag}
            </when>
            <otherwise>
                AND B.DEL_FLAG = 0
            </otherwise>
        </choose>
        <if test="description != null and description != ''">
            and B.DESCRIPTION = #{description}
        </if>
        <if test="spare1 != null and spare1 != ''">
            and B.SPARE1 = #{spare1}
        </if>
        <if test="spare2 != null and spare2 != ''">
            and B.SPARE2 = #{spare2}
        </if>
        <if test='key != null and key !=""'>
            AND (
            B.NAME like concat('%',concat(#{key},'%'))
            or B.UNION_CODE like concat('%',concat(#{key},'%'))
            or B.ORGAN_CODE like concat('%',concat(#{key},'%'))
            )
        </if>
        <if test="ids != null ">
            and B.ORGAN_ID IN
            <foreach item="item" collection="ids" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <!-- 各个数据库差异化的查询条件处理，如时间字段 -->
        <choose>
            <when test='_databaseId == "mysql"'>

            </when>
            <when test='_databaseId == "dm8" or _databaseId == "xg"'>

            </when>
            <otherwise>

            </otherwise>
        </choose>

    </sql>

    <!-- save object，保存对象信息 -->
    <insert id="save" parameterType="net.linlan.sys.base.entity.BaseOrgan">
        INSERT INTO BASE_ORGAN
        (
            ORGAN_ID, XZQH_ID, NAME, SOURCE, UNION_CODE, ORGAN_CODE, CREATE_TYPE, CREATE_TIME, LAST_TIME, PRIORITY, DEL_FLAG, DELETE_TIME, DESCRIPTION, SPARE1, SPARE2
        )
        VALUES
        (
            #{id}, #{xzqhId}, #{name}, #{source}, #{unionCode}, #{organCode}, #{createType}, #{createTime}, #{lastTime}, #{priority}, #{delFlag}, #{deleteTime}, #{description}, #{spare1}, #{spare2}
        )
    </insert>

    <insert id="batchSave" parameterType="java.util.List">
        <choose>
            <when test='_databaseId == "mysql"'>
                INSERT INTO BASE_ORGAN
                (
                ORGAN_ID, XZQH_ID, NAME, SOURCE, UNION_CODE, ORGAN_CODE, CREATE_TYPE, CREATE_TIME, LAST_TIME, PRIORITY, DEL_FLAG, DELETE_TIME, DESCRIPTION, SPARE1, SPARE2
                )
                VALUES
                <foreach collection="list" index="index" item="item" separator=",">
                    (
                    #{item.id}, #{item.xzqhId}, #{item.name}, #{item.source}, #{item.unionCode}, #{item.organCode}, #{item.createType}, #{item.createTime}, #{item.lastTime}, #{item.priority}, #{item.delFlag}, #{item.deleteTime}, #{item.description}, #{item.spare1}, #{item.spare2}
                    )
                </foreach>
            </when>
            <otherwise>
                <foreach collection="list" item="item" index="index" open="begin" close=";end;" separator=";">
                    INSERT INTO BASE_ORGAN
                    (
                    ORGAN_ID, XZQH_ID, NAME, SOURCE, UNION_CODE, ORGAN_CODE, CREATE_TYPE, CREATE_TIME, LAST_TIME, PRIORITY, DEL_FLAG, DELETE_TIME, DESCRIPTION, SPARE1, SPARE2
                    )
                    VALUES
                    (
                    #{item.id}, #{item.xzqhId}, #{item.name}, #{item.source}, #{item.unionCode}, #{item.organCode}, #{item.createType}, #{item.createTime}, #{item.lastTime}, #{item.priority}, #{item.delFlag}, #{item.deleteTime}, #{item.description}, #{item.spare1}, #{item.spare2}
                    )
                </foreach>
            </otherwise>
        </choose>
    </insert>

    <!-- update object，更新对象信息 -->
    <update id="update" parameterType="net.linlan.sys.base.entity.BaseOrgan">
        UPDATE BASE_ORGAN
        <set>
            <if test="xzqhId != null">XZQH_ID = #{xzqhId}, </if>
            <if test="name != null">NAME = #{name}, </if>
            <if test="source != null">SOURCE = #{source}, </if>
            <if test="unionCode != null">UNION_CODE = #{unionCode}, </if>
            <if test="organCode != null">ORGAN_CODE = #{organCode}, </if>
            <if test="createType != null">CREATE_TYPE = #{createType}, </if>
            <if test="createTime != null">CREATE_TIME = #{createTime}, </if>
            <if test="lastTime != null">LAST_TIME = #{lastTime}, </if>
            <if test="priority != null">PRIORITY = #{priority}, </if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag}, </if>
            <if test="deleteTime != null">DELETE_TIME = #{deleteTime}, </if>
            <if test="description != null">DESCRIPTION = #{description}, </if>
            <if test="spare1 != null">SPARE1 = #{spare1}, </if>
            <if test="spare2 != null">SPARE2 = #{spare2}</if>
        </set>
        WHERE ORGAN_ID = #{id}
    </update>

    <!-- delete by id，通过主键删除对象 -->
    <update id="deleteById">
        <choose>
            <when test='_databaseId == "mysql"'>
                update BASE_ORGAN set DEL_FLAG = 1, DELETE_TIME = sysdate(), LAST_TIME = sysdate() where ORGAN_ID =
                #{value}
            </when>
            <when test='_databaseId == "dm8" or _databaseId == "xg"'>
                update BASE_ORGAN set DEL_FLAG = 1, DELETE_TIME = sysdate(), LAST_TIME = sysdate() where ORGAN_ID =
                #{value}
            </when>
            <otherwise>
                update BASE_ORGAN set DEL_FLAG = 1, DELETE_TIME = sysdate(), LAST_TIME = sysdate() where ORGAN_ID =
                #{value}
            </otherwise>
        </choose>
    </update>

    <!-- delete by ids，通过主键数组批量删除对象 -->
    <update id="deleteByIds">
        <choose>
            <when test='_databaseId == "mysql"'>
                update BASE_ORGAN set DEL_FLAG = 1, DELETE_TIME = sysdate(), LAST_TIME = sysdate()
                WHERE ORGAN_ID IN
                <foreach item="id" collection="array" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <when test='_databaseId == "dm8" or _databaseId == "xg"'>
                update BASE_ORGAN set DEL_FLAG = 1, DELETE_TIME = sysdate(), LAST_TIME = sysdate()
                WHERE ORGAN_ID IN
                <foreach item="id" collection="array" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                update BASE_ORGAN set DEL_FLAG = 1, DELETE_TIME = sysdate(), LAST_TIME = sysdate()
                WHERE ORGAN_ID IN
                <foreach item="id" collection="array" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </otherwise>
        </choose>
    </update>

    <!-- query total，通过输入的条件，查询返回结果的数量，返回值为int -->
    <select id="getCount" resultType="int">
        SELECT COUNT(1)
        FROM BASE_ORGAN B
        WHERE 1 = 1
        <include refid="commonList"></include>
    </select>

    <!-- 以下为新增特定的操作 -->
    <!-- get list with dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <resultMap type="net.linlan.sys.base.dto.BaseOrganDto" extends="baseOrganMap" id="baseOrganDtoMap">
        <result property="xzqhName" column="xzqhName"/>

    </resultMap>

    <!-- get page with param input dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <select id="getPageDto" resultMap="baseOrganDtoMap">
        SELECT
        B.ORGAN_ID, B.XZQH_ID, B.NAME, B.SOURCE, B.UNION_CODE, B.ORGAN_CODE, B.CREATE_TYPE, B.CREATE_TIME, B.LAST_TIME, B.PRIORITY, B.DEL_FLAG, B.DELETE_TIME, B.DESCRIPTION, B.SPARE1, B.SPARE2
        , XZQH.NAME as xzqhName
        FROM BASE_ORGAN B
        <include refid="commonUnionJoin"></include>
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>

    </select>

    <!-- get dto with input id，通过ID，查询dto对象 -->
    <select id="getDtoById" resultMap="baseOrganDtoMap">
        SELECT
        B.ORGAN_ID, B.XZQH_ID, B.NAME, B.SOURCE, B.UNION_CODE, B.ORGAN_CODE, B.CREATE_TYPE, B.CREATE_TIME, B.LAST_TIME, B.PRIORITY, B.DEL_FLAG, B.DELETE_TIME, B.DESCRIPTION, B.SPARE1, B.SPARE2
        , XZQH.NAME as xzqhName
        FROM BASE_ORGAN B
        <include refid="commonUnionJoin"></include>
        WHERE ORGAN_ID = #{value}
    </select>

    <!-- 关联表 -->
    <sql id="commonUnionJoin">
        left join BASE_XZQH XZQH on B.XZQH_ID = XZQH.XZQH_ID
    </sql>

    <select id="getExportList" resultMap="baseOrganDtoMap">
        SELECT
        ORGAN_ID, XZQH_ID, NAME, SOURCE, UNION_CODE, ORGAN_CODE, CREATE_TYPE, CREATE_TIME, LAST_TIME, PRIORITY, DEL_FLAG, DELETE_TIME, DESCRIPTION, SPARE1, SPARE2
        , (select NAME from BASE_XZQH WHERE XZQH_ID = B.XZQH_ID) as xzqhName
        FROM BASE_ORGAN B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>
    </select>

    <select id="getByName" resultMap="baseOrganMap">
        select * from BASE_ORGAN where NAME=#{organName}
        AND DEL_FLAG=0
        <choose>
            <when test='_databaseId == "mysql"'>
                limit 1
            </when>
            <when test='_databaseId == "dm8" or _databaseId == "xg"'>
                limit 1
            </when>
            <otherwise>
                AND rownum&lt;=1
            </otherwise>
        </choose>
    </select>

    <select id="getListByOutIds" resultMap="baseOrganMap">
        select *
        FROM BASE_ORGAN where SPARE2 IN
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="getOrganByNameUnicode" resultMap="baseOrganMap">
        select * from BASE_ORGAN where NAME=#{organName}
        <if test="unionCode != null">
            AND UNION_CODE = #{unionCode}
        </if>
        AND DEL_FLAG=0
        <choose>
            <when test='_databaseId == "mysql"'>
                limit 1
            </when>
            <when test='_databaseId == "dm8" or _databaseId == "xg"'>
                limit 1
            </when>
            <otherwise>
                AND rownum&lt;=1
            </otherwise>
        </choose>
    </select>

    <select id="getOrganByOrganCode" resultMap="baseOrganMap">
        select * from BASE_ORGAN where 1=1
        <if test='organCode != null and organCode !=""'>
            AND ORGAN_CODE = #{organCode}
        </if>
        AND DEL_FLAG=0
        <choose>
            <when test='_databaseId == "mysql"'>
                limit 1
            </when>
            <when test='_databaseId == "dm8" or _databaseId == "xg"'>
                limit 1
            </when>
            <otherwise>
                AND rownum&lt;=1
            </otherwise>
        </choose>
    </select>


    <resultMap type="net.linlan.sys.base.dto.KeyValueMapDto" id="baseOrganKvMap">
        <id property="cmsKey" column="cmsKey"/>
        <result property="cmsValue" column="cmsValue"/>
    </resultMap>

    <select id="getKeyValueList" resultMap="baseOrganKvMap">
        SELECT DISTINCT(B.ORGAN_ID) AS cmsKey, B.NAME as cmsValue
        FROM
        BASE_ORGAN B
        WHERE 1 = 1 AND B.DEL_FLAG = 0
        <if test='key != null and key !=""'>
            AND (
            B.NAME like concat('%',concat(#{key},'%'))
            or B.UNION_CODE like concat('%',concat(#{key},'%'))
            or B.ORGAN_CODE like concat('%',concat(#{key},'%'))
            )
        </if>
        <if test='organCode != null and organCode !=""'>
            AND B.ORGAN_CODE = #{organCode}
        </if>
        <if test='organName != null and organName !=""'>
            AND B.NAME = #{organName}
        </if>
    </select>

    <select id="getOrganByUnicode" resultMap="baseOrganMap">
        select * from BASE_ORGAN where 1=1
        AND UNION_CODE = #{unionCode}
        AND DEL_FLAG=0
        <choose>
            <when test='_databaseId == "mysql" or _databaseId == "dm8" or _databaseId == "xg"'>
                limit 1
            </when>
            <otherwise>
                AND rownum&lt;=1
            </otherwise>
        </choose>
    </select>


</mapper>
