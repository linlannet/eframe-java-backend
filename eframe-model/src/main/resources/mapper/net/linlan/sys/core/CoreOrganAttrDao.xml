<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.sys.core.dao.CoreOrganAttrDao">

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.sys.core.entity.CoreOrganAttr" id="coreOrganAttrMap">
        <id property="id" column="ORGAN_ID"/>
        <result property="attrId" column="ATTR_ID"/>
        <result property="attrKey" column="ATTR_KEY"/>
        <result property="attrValue" column="ATTR_VALUE"/>
    </resultMap>

    <!-- find by id，通过主键获取对象 -->
    <select id="findById" resultMap="coreOrganAttrMap">
        SELECT
        ORGAN_ID, ATTR_ID, ATTR_KEY, ATTR_VALUE
        FROM CORE_ORGAN_ATTR B
        WHERE B.ORGAN_ID = #{value}
    </select>

    <!-- get list，通过输入的条件，获取返回的list列表对象，采用相应的分页规则进行分页处理 -->
    <select id="getList" resultMap="coreOrganAttrMap">
        SELECT
        B.ORGAN_ID, B.ATTR_ID, B.ATTR_KEY, B.ATTR_VALUE
        FROM CORE_ORGAN_ATTR B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>
    </select>

    <!-- 通用排序SQL，如果传入参数按照参数排序，如果未传入参数，按照主键排序 -->
    <sql id="getListOrderBy">
        <choose>
            <when test='orderBy != null'>
                <choose>
                    <when test='orderBy == 0'>
                        ORDER BY B.CREATE_TIME DESC
                    </when>
                    <when test='orderBy == 1'>
                        ORDER BY B.CREATE_TIME ASC
                    </when>
                    <when test='orderBy == 2'>
                        ORDER BY B.PRIORITY DESC
                    </when>
                    <when test='orderBy == 3'>
                        ORDER BY B.PRIORITY ASC
                    </when>
                    <otherwise>
                        ORDER BY B.RECORD_ID ASC
                    </otherwise>
                </choose>
            </when>
            <otherwise>
                ORDER BY B.RECORD_ID ASC
            </otherwise>
        </choose>
    </sql>

    <!-- sql commonList 通过输入的条件，获取返回的list列表对象 -->
    <sql id="commonList">
        <!--  只允许默认的本表的字段查询，查询条件可通过Param定义，默认全部字段，后续根据Param内的定义，可删除不需要的查询字段 -->
        <if test="id != null and id != ''">
            and B.ORGAN_ID = #{id}
        </if>
        <if test="attrId != null and attrId != ''">
            and B.ATTR_ID = #{attrId}
        </if>
        <if test="attrKey != null and attrKey != ''">
            and B.ATTR_KEY = #{attrKey}
        </if>
        <if test="attrValue != null and attrValue != ''">
            and B.ATTR_VALUE = #{attrValue}
        </if>

        <!-- 各个数据库差异化的查询条件处理，如时间字段 -->
        <choose>
            <when test='_databaseId == "mysql"'>

            </when>
            <when test='_databaseId == "dm8"'>

            </when>
            <otherwise>

            </otherwise>
        </choose>

    </sql>

    <!-- save object，保存对象信息 -->
    <insert id="save" parameterType="net.linlan.sys.core.entity.CoreOrganAttr">
        INSERT INTO CORE_ORGAN_ATTR
        (
        ORGAN_ID, ATTR_ID, ATTR_KEY, ATTR_VALUE
        )
        VALUES
        (
        #{id}, #{attrId}, #{attrKey}, #{attrValue}
        )
    </insert>

    <insert id="batchSave" parameterType="java.util.List">
        <choose>
            <when test='_databaseId == "mysql"'>
                INSERT INTO CORE_ORGAN_ATTR
                (
                ORGAN_ID, ATTR_ID, ATTR_KEY, ATTR_VALUE
                )
                VALUES
                <foreach collection="list" index="index" item="item" separator=",">
                    (
                    #{item.id}, #{item.attrId}, #{item.attrKey}, #{item.attrValue}
                    )
                </foreach>
            </when>
            <otherwise>
                <foreach collection="list" item="item" index="index" open="begin" close=";end;" separator=";">
                    INSERT INTO CORE_ORGAN_ATTR
                    (
                    ORGAN_ID, ATTR_ID, ATTR_KEY, ATTR_VALUE
                    )
                    VALUES
                    (
                    #{item.id}, #{item.attrId}, #{item.attrKey}, #{item.attrValue}
                    )
                </foreach>
            </otherwise>
        </choose>
    </insert>

    <!-- update object，更新对象信息 -->
    <update id="update" parameterType="net.linlan.sys.core.entity.CoreOrganAttr">
        UPDATE CORE_ORGAN_ATTR
        <set>
            <if test="attrId != null">ATTR_ID = #{attrId}, </if>
            <if test="attrKey != null">ATTR_KEY = #{attrKey}, </if>
            <if test="attrValue != null">ATTR_VALUE = #{attrValue}</if>
        </set>
        WHERE ORGAN_ID = #{id}
    </update>

    <!-- delete by id，通过主键删除对象 -->
    <delete id="deleteById">
        DELETE FROM CORE_ORGAN_ATTR
        WHERE ORGAN_ID = #{value}
    </delete>

    <!-- delete by ids，通过主键数组批量删除对象 -->
    <delete id="deleteByIds">
        DELETE FROM CORE_ORGAN_ATTR
        WHERE ORGAN_ID IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- query total，通过输入的条件，查询返回结果的数量，返回值为int -->
    <select id="getCount" resultType="int">
        SELECT COUNT(1)
        FROM CORE_ORGAN_ATTR B
        WHERE 1 = 1
        <include refid="commonList"></include>
    </select>

    <!-- 以下为新增特定的操作 -->

</mapper>
