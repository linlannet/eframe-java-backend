<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.sys.comm.dao.CommFileDao">

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.sys.comm.entity.CommFile" id="commFileMap">
        <id property="id" column="FILE_PATH"/>
        <result property="resclassId" column="RESCLASS_ID"/>
        <result property="creatorId" column="CREATOR_ID"/>
        <result property="appId" column="APP_ID"/>
        <result property="userType" column="USER_TYPE"/>
        <result property="fileName" column="FILE_NAME"/>
        <result property="fileIsvalid" column="FILE_ISVALID"/>
        <result property="refId" column="REF_ID"/>
        <result property="refType" column="REF_TYPE"/>
        <result property="fileSize" column="FILE_SIZE"/>
        <result property="fileExtension" column="FILE_EXTENSION"/>
        <result property="createTime" column="CREATE_TIME"/>
    </resultMap>

    <!-- find by id，通过主键获取对象 -->
    <select id="findById" resultMap="commFileMap">
        SELECT
        FILE_PATH, RESCLASS_ID, CREATOR_ID, APP_ID, USER_TYPE, FILE_NAME, FILE_ISVALID, REF_ID, REF_TYPE, FILE_SIZE, FILE_EXTENSION, CREATE_TIME
        FROM COMM_FILE
        WHERE FILE_PATH = #{value}
    </select>

    <!-- get list，通过输入的条件，获取返回的list列表对象，采用相应的分页规则进行分页处理 -->
    <select id="getList" resultMap="commFileMap">
        SELECT
        B.FILE_PATH, B.RESCLASS_ID, B.CREATOR_ID, B.APP_ID, B.USER_TYPE, B.FILE_NAME, B.FILE_ISVALID, B.REF_ID, B.REF_TYPE, B.FILE_SIZE, B.FILE_EXTENSION, B.CREATE_TIME
        FROM COMM_FILE B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>
    </select>


    <!-- 通用排序SQL，如果传入参数按照参数排序，如果未传入参数，按照主键排序 -->
    <sql id="getListOrderBy">
        <choose>
            <when test='orderBy != null'>
                ORDER BY FILE_PATH ASC
            </when>
            <otherwise>
                ORDER BY FILE_PATH DESC
            </otherwise>
        </choose>
    </sql>

    <!-- sql commonList 通过输入的条件，获取返回的list列表对象
    -->
    <sql id="commonList">
        <!--  只允许默认的本表的字段查询，查询条件可通过Param定义，默认全部字段，后续根据Param内的定义，可删除不需要的查询字段 -->
        <if test="resclassId != null and resclassId != ''">
            and B.RESCLASS_ID = #{resclassId}
        </if>
        <if test="appId != null and appId.trim() != ''">
            and B.APP_ID = #{appId}
        </if>
        <if test="fileName != null and fileName != ''">
            and B.FILE_NAME = #{fileName}
        </if>
        <if test="fileIsvalid != null">
            and B.FILE_ISVALID = #{fileIsvalid}
        </if>
        <if test="refId != null and refId != ''">
            and B.REF_ID = #{refId}
        </if>
        <if test="refType != null and refType != ''">
            and B.REF_TYPE = #{refType}
        </if>
        <if test="fileSize != null and fileSize != ''">
            and B.FILE_SIZE = #{fileSize}
        </if>
        <if test="fileExtension != null and fileExtension != ''">
            and B.FILE_EXTENSION = #{fileExtension}
        </if>
        <if test='key != null and key.trim() != ""'>
            and (FILE_PATH like concat('%',concat(#{key},'%')
            or FILE_NAME like concat('%',concat(#{key},'%') )
        </if>
        <if test="q!=null and q != ''">
            AND (B.FILE_PATH LIKE CONCAT('%',#{q},'%')
            OR B.FILE_NAME LIKE CONCAT('%',#{q},'%'))
        </if>

        <!-- 各个数据库差异化的查询条件处理，如时间字段 -->
        <choose>
            <when test='_databaseId == "mysql"'>
                <if test='startTime != null and  startTime != "" and endTime != null and  endTime != "" '>
                    <![CDATA[ and date_format(B.CREATE_TIME,'%Y-%m-%d') >= date_format(#{startTime},'%Y-%m-%d')
                and date_format(B.CREATE_TIME,'%Y-%m-%d')  <= date_format(#{endTime},'%Y-%m-%d') ]]>
                </if>
            </when>
            <when test='_databaseId == "dm8" or _databaseId == "xg"'>
                <if test='startTime != null and  startTime != "" and endTime != null and  endTime != "" '>
                    <![CDATA[ and date_format(B.CREATE_TIME,'%Y-%m-%d') >= date_format(#{startTime},'%Y-%m-%d')
                and date_format(B.CREATE_TIME,'%Y-%m-%d') <= date_format(#{endTime},'%Y-%m-%d') ]]>
                </if>
            </when>
            <otherwise>
                <if test='startTime != null and  startTime != "" and endTime != null and  endTime != "" '>
                    <![CDATA[ and to_date(B.CREATE_TIME,'YYYY-MM-DD') >= to_date(#{startTime},'YYYY-MM-DD')
                and to_date(B.CREATE_TIME,'YYYY-MM-DD') <= to_date(#{endTime},'YYYY-MM-DD') ]]>
                </if>
            </otherwise>
        </choose>

    </sql>

    <!-- save object，保存对象信息 -->
    <insert id="save" parameterType="net.linlan.sys.comm.entity.CommFile">
        INSERT INTO COMM_FILE
        (
        FILE_PATH, RESCLASS_ID, CREATOR_ID, APP_ID, USER_TYPE, FILE_NAME, FILE_ISVALID, REF_ID, REF_TYPE, FILE_SIZE, FILE_EXTENSION, CREATE_TIME
        )
        VALUES
        (
        #{id}, #{resclassId}, #{creatorId}, #{appId}, #{userType}, #{fileName}, #{fileIsvalid}, #{refId}, #{refType}, #{fileSize}, #{fileExtension}, #{createTime}
        )
    </insert>

    <!-- update object，更新对象信息 -->
    <update id="update" parameterType="net.linlan.sys.comm.entity.CommFile">
        UPDATE COMM_FILE
        <set>
            <if test="resclassId != null">RESCLASS_ID = #{resclassId}, </if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId}, </if>
            <if test="appId != null">APP_ID = #{appId}, </if>
            <if test="userType != null">USER_TYPE = #{userType}, </if>
            <if test="fileName != null">FILE_NAME = #{fileName}, </if>
            <if test="fileIsvalid != null">FILE_ISVALID = #{fileIsvalid}, </if>
            <if test="refId != null">REF_ID = #{refId}, </if>
            <if test="refType != null">REF_TYPE = #{refType}, </if>
            <if test="fileSize != null">FILE_SIZE = #{fileSize}, </if>
            <if test="fileExtension != null">FILE_EXTENSION = #{fileExtension}, </if>
            <if test="createTime != null">CREATE_TIME = #{createTime}</if>
        </set>
        WHERE FILE_PATH = #{id}
    </update>

    <!-- delete by id，通过主键删除对象 -->
    <delete id="deleteById">
        DELETE FROM COMM_FILE
        WHERE FILE_PATH = #{value}
    </delete>

    <!-- delete by ids，通过主键数组批量删除对象 -->
    <delete id="deleteByIds">
        DELETE FROM COMM_FILE
        WHERE FILE_PATH IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- query total，通过输入的条件，查询返回结果的数量，返回值为int -->
    <select id="getCount" resultType="int">
        SELECT COUNT(1)
        FROM COMM_FILE B
        WHERE 1 = 1
        <include refid="commonList"></include>
    </select>

    <!-- 以下为新增特定的操作 -->
    <!-- get list with dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <resultMap type="net.linlan.sys.comm.dto.CommFileDto" id="commFileDtoMap">
        <id property="id" column="FILE_PATH"/>
        <result property="resclassId" column="RESCLASS_ID"/>
        <result property="fileName" column="FILE_NAME"/>
        <result property="fileIsvalid" column="FILE_ISVALID"/>
        <result property="createTime" column="CREATE_TIME"/>
    </resultMap>

    <!-- get page with param input dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <select id="getPageDto" resultMap="commFileDtoMap">
        SELECT
        B.FILE_PATH, B.RESCLASS_ID, B.FILE_NAME, B.FILE_ISVALID, B.CREATE_TIME
        FROM COMM_FILE B
        WHERE 1=1
        <include refid="commonList"></include>
        ORDER BY B.CREATE_TIME DESC

    </select>

    <!-- get dto with input id，通过ID，查询dto对象 -->
    <select id="getDtoById" resultMap="commFileDtoMap">
        SELECT
        FILE_PATH, RESCLASS_ID, CREATOR_ID, APP_ID, USER_TYPE, FILE_NAME, FILE_ISVALID, REF_ID, REF_TYPE, FILE_SIZE, FILE_EXTENSION, CREATE_TIME
        FROM COMM_FILE
        WHERE FILE_PATH = #{value}
    </select>


</mapper>
