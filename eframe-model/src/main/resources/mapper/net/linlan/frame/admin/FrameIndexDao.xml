<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.frame.admin.dao.FrameIndexDao">

    <resultMap id="indexApplicationMap" type="net.linlan.frame.admin.dto.IndexApplicationDto">
        <result property="organNum" column="organNum"/>
        <result property="deptNum" column="deptNum"/>
        <result property="peopleNum" column="peopleNum"/>
        <result property="roleNum" column="roleNum"/>
        <result property="dicTypeNum" column="dicTypeNum"/>
        <result property="appNum" column="appNum"/>
        <result property="fileNum" column="fileNum"/>
        <result property="paramNum" column="paramNum"/>
    </resultMap>


    <select id="getIndexApplicationCount" resultType="net.linlan.frame.admin.dto.IndexApplicationDto">

        SELECT A.TOTAL AS organNum,B.TOTAL AS deptNum,C.TOTAL AS peopleNum,D.TOTAL AS roleNum, E.TOTAL AS dicTypeNum,F.TOTAL AS appNum,G.TOTAL AS fileNum,H.TOTAL AS paramNum from
        (SELECT count(*) AS TOTAL from BASE_ORGAN) A,
        (SELECT count(*) AS TOTAL from ADMIN_DEPT ) B,
        (SELECT count(*) AS TOTAL from ADMIN_USER ) C,
        (SELECT count(*) AS TOTAL from SYS_ROLE) D,
        (SELECT count(*) AS TOTAL from BASE_DIC_TYPE) E,
        (SELECT count(*) AS TOTAL from BASE_APP) F,
        (SELECT count(*) AS TOTAL from COMM_FILE)G,
        (SELECT count(*) AS TOTAL from BASE_CONFIG_WHOLE)H


    </select>

    <resultMap id="indexElementMap" type="net.linlan.frame.admin.dto.IndexElementDto">
        <result property="objectNum" column="objectNum"/>
        <result property="modelNum" column="modelNum"/>
    </resultMap>
    <select id="getIndexElementCount" resultType="net.linlan.frame.admin.dto.IndexElementDto">

        SELECT A.TOTAL AS objectNum,B.TOTAL AS modelNum from
                         (SELECT count(*) AS TOTAL from META_DATA_ENTITY) A,
                         (SELECT count(*) AS TOTAL from MODA_MODEL ) B

    </select>

    <resultMap id="indexManageMap" type="net.linlan.frame.admin.dto.IndexManageDto">
        <result property="siteNum" column="siteNum"/>
        <result property="accountNum" column="accountNum"/>
        <result property="serviceOrganNum" column="serviceOrganNum"/>
    </resultMap>
    <select id="getIndexManageCount" resultType="net.linlan.frame.admin.dto.IndexManageDto">

        SELECT A.TOTAL AS appNum,B.TOTAL AS accountNum,C.TOTAL AS serviceOrganNum from
        (SELECT count(*) AS TOTAL from BASE_APP) A,
        (SELECT count(*) AS TOTAL from CORE_ACCOUNT ) B,
        (SELECT count(*) AS TOTAL from CORE_ORGAN  WHERE ORGAN_PROPERTY ='三方服务商' ) C

    </select>




</mapper>
