<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.frame.admin.dao.AdminUserPositionDao">

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.frame.admin.entity.AdminUserPosition" id="adminUserPositionMap">
        <id property="id" column="USERPOS_ID"/>
        <result property="positionId" column="POSITION_ID"/>
        <result property="isMember" column="IS_MEMBER"/>
        <result property="type" column="TYPE"/>
        <result property="adminId" column="ADMIN_ID"/>
        <result property="isDef" column="IS_DEF"/>
        <result property="delFlag" column="DEL_FLAG"/>
        <result property="createTime" column="CREATE_TIME"/>
    </resultMap>

    <select id="selectPostListByAdminId" parameterType="Long" resultType="Long">
        select B.POSITION_ID
        from ADMIN_POSITION B
                 left join ADMIN_USER_POSITION up on up.POSITION_ID = B.POSITION_ID
                 left join ADMIN_USER UR on UR.ADMIN_ID = up.ADMIN_ID
        where UR.ADMIN_ID = #{adminId}
    </select>

    <!-- 以下为新增特定的操作 -->
    <delete id="deleteUserPositionByAdminId" parameterType="Long">
        delete from ADMIN_USER_POSITION where ADMIN_ID=#{adminId}
    </delete>

    <select id="countUserPositionById" resultType="Integer">
        select count(1) from ADMIN_USER_POSITION where POSITION_ID=#{positionId}
    </select>

    <delete id="deleteUserPositionByAdminIds" parameterType="Long">
        delete from ADMIN_USER_POSITION where ADMIN_ID in
        <foreach collection="array" item="adminId" open="(" separator="," close=")">
            #{adminId}
        </foreach>
    </delete>

    <insert id="batchUserPosition">
        insert into ADMIN_USER_POSITION (ADMIN_ID, POSITION_ID) values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.adminId}, #{item.positionId})
        </foreach>
    </insert>

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.sys.role.entity.SysPosition" id="adminPositionMap">
        <id property="id" column="POSITION_ID"/>
        <result property="name" column="NAME"/>
        <result property="code" column="CODE"/>
        <result property="status" column="POS_NATURE"/>
        <result property="delFlag" column="DEL_FLAG"/>
    </resultMap>

    <select id="selectPositionsByUsername" parameterType="String" resultMap="adminPositionMap">
        select B.POSITION_ID, B.NAME, B.CODE
        from ADMIN_POSITION B
                 left join ADMIN_USER_POSITION AUP on AUP.POSITION_ID = B.POSITION_ID
                 left join ADMIN_USER UR on UR.ADMIN_ID = AUP.ADMIN_ID
        where UR.USERNAME = #{username}
    </select>

</mapper>
