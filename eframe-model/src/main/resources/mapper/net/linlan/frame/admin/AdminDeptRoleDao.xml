<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.frame.admin.dao.AdminDeptRoleDao">

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.frame.admin.entity.AdminDeptRole" id="adminDeptRoleMap">
        <id property="id" column="DEPTROLE_ID"/>
        <result property="roleId" column="ROLE_ID"/>
        <result property="deptId" column="DEPT_ID"/>
    </resultMap>
    
    <!-- 以下为新增特定的操作 -->
    <select id="getCountByDeptId" resultType="Integer">
        select count(1) from ADMIN_ROLE_DEPT where DEPT_ID=#{deptId}
    </select>

    <delete id="deleteByRoleId" parameterType="Long">
        delete from ADMIN_ROLE_DEPT where ROLE_ID=#{roleId}
    </delete>

    <delete id="deleteByRoleIds" parameterType="Long">
        delete from ADMIN_ROLE_DEPT where ROLE_ID in
        <foreach collection="array" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </delete>

    <insert id="batchSaveDeptRole">
        insert into ADMIN_ROLE_DEPT (ROLE_ID, DEPT_ID) values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.roleId}, #{item.deptId})
        </foreach>
    </insert>

</mapper>
